{
  "name": "threshold-projects",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/supabase-environment.mjs check --require-development",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "test:e2e:desktop": "playwright test --project=desktop-chromium",
    "test:e2e:list": "playwright test --list",
    "typecheck": "tsc --noEmit --incremental false",
    "map:generate": "node scripts/implementation-map.mjs generate",
    "map:check": "node scripts/implementation-map.mjs validate",
    "env:check": "node scripts/supabase-environment.mjs check --require-link",
    "db:status": "node scripts/supabase-environment.mjs status",
    "db:start": "supabase start -x studio",
    "db:stop": "supabase stop",
    "db:test": "supabase test db",
    "db:test:concurrency": "bash scripts/test-prj06-concurrency.sh",
    "db:seed:dev": "node scripts/seed-development.mjs",
    "db:lint": "node scripts/supabase-environment.mjs lint",
    "db:push:dry-run": "node scripts/supabase-environment.mjs push-dry-run",
    "db:push": "node scripts/supabase-environment.mjs push",
    "db:types": "node scripts/supabase-environment.mjs types",
    "verify": "pnpm map:check && pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "supabase": "^2.116.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "type": "module"
}
